name: Blender Lite Turnip APK

on:
  workflow_dispatch:

permissions:
  contents: read

jobs:
  build:
    name: Build Android ARM64 APK
    runs-on: ubuntu-24.04
    timeout-minutes: 360

    env:
      ANDROID_HOME: /home/runner/android-sdk
      ANDROID_NDK_VERSION: 30.0.14904198-beta1
      ANDROID_API: 31
      ANDROID_TARGET_API: 34
      ANDROID_ABI: arm64-v8a

    steps:
      - name: Checkout repository
        uses: actions/checkout@v4
        with:
          ref: ${{ github.ref }}
          lfs: false
          submodules: false

      - name: Install Linux dependencies
        run: |
          sudo apt-get update
          sudo apt-get install -y \
            build-essential gcc-14 g++-14 \
            cmake ninja-build git git-lfs \
            python3 python3-pip python3-venv \
            pkg-config curl wget unzip zip \
            patchelf libtbb-dev libssl-dev \
            libffi-dev zlib1g-dev libxml2-dev \
            libpng-dev libjpeg-dev libtiff-dev \
            libopenexr-dev libboost-all-dev

      - name: Configure Java
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '17'

      - name: Configure Android SDK
        uses: android-actions/setup-android@v3

      - name: Install Android SDK and NDK
        run: |
          mkdir -p "$ANDROID_HOME"
          yes | sdkmanager --sdk_root="$ANDROID_HOME" --licenses

          sdkmanager --sdk_root="$ANDROID_HOME" \
            "platform-tools" \
            "platforms;android-35" \
            "build-tools;35.0.1" \
            "ndk;30.0.14904198-beta1"

          test -f "$ANDROID_HOME/ndk/30.0.14904198-beta1/build/cmake/android.toolchain.cmake"

      - name: Initialize Blender dependencies
        run: |
          git lfs install
          git lfs pull

          git -c submodule.lib/linux_x64.update=checkout \
              -c submodule.lib/android_arm64.update=checkout \
              submodule update --init lib/linux_x64 lib/android_arm64

          test -d lib/linux_x64/tbb/lib
          test -d lib/android_arm64

          git -C lib/linux_x64 lfs pull || true
          git -C lib/android_arm64 lfs pull || true

      - name: Check build environment
        run: |
          source build_files/android/env.sh
          cmake --version
          ninja --version
          gcc-14 --version
          java -version
          python3 --version
          echo "NDK: $ANDROID_NDK_ROOT"

      - name: Build Blender Lite with Turnip
        run: |
          python3 build_files/android/build.py lite --turnip

      - name: Verify APK
        run: |
          APK="../blender_build_android/android_apk_stage_lite-turnip/blender-lite-turnip.apk"

          if [ ! -f "$APK" ]; then
            echo "APK not found at expected location."
            find ../blender_build_android -name "*.apk" -type f
            exit 1
          fi

          mkdir -p dist
          cp "$APK" dist/
          ls -lh dist/

      - name: Upload APK
        uses: actions/upload-artifact@v4
        with:
          name: Blender-Mobile-Lite-Turnip
          path: dist/blender-lite-turnip.apk
          retention-days: 14
